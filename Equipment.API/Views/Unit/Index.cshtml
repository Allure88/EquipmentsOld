@using Equipment.Domain.Entities.Units
@model List<EquipmentUnit>

@{
    ViewData["Title"] = "Оборудование";
    Layout = "_Layout";
}

<p class="h5" style="margin-bottom:20px">Оборудование</p>


@foreach (var unit in Model)
{
    <div class="row">
        <div class="col-auto border py-1" style="background-color: #DCDCDC; min-width: 70px">@unit.Id</div>
        <div class="col-2 border py-1" style="background-color: #DCDCDC">@unit.Name</div>
        <div class="col-2 border py-1" style="background-color: #DCDCDC">@unit.Company.Name</div>
        <div class="col-2 border py-1" style="background-color: #DCDCDC">
            <div class="d-flex mb-1">
                <a asp-action="Edit" class="btn btn-sm btn-outline-warning flex-fill me-1" asp-route-id="@unit.Id">Редактировать</a>
            </div>
        </div>
        <div class="col-2 border py-1" style="background-color: #DCDCDC">
            <form asp-action="Delete" method="post">
                <div class="d-flex mb-1">
                    <input type="hidden" name="id" value="@unit.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger flex-fill me-1">Удалить</button>
                </div>
            </form>
        </div>
    </div>


    <!-- INTPUTS -->
    foreach (var port in unit.InPorts)
    {
        <div class="row">
            <div class="col-auto border py-1" style="background-color: #EBEBEB; min-width: 70px"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Name</div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Diametr мм</div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
        </div>
    }
 

    <!-- OUTPUTS -->
    foreach (var port in unit.OutPorts)
    {
        <div class="row">
            <div class="col-auto border py-1" style="background-color: #EBEBEB; min-width: 70px"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Name</div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Diametr мм</div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
        </div>
    }



}
<a asp-controller="Unit" asp-action="Create" class="btn btn btn-outline-success my-2">Создать новое оборудование</a>