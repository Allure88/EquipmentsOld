@using Equipment.Domain.Entities.Ports
@model List<Port>

@{
    ViewData["Title"] = "Порты";
    Layout = "_Layout";
}


<p class="h5" style="margin-bottom:20px">Порты</p>


@foreach (var port in Model)
{
    <div class="row">
        <div class="col-auto border py-1" style="background-color: #EBEBEB ; min-width: 70px">@port.Id</div>
        <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Name</div>
        <div class="col-2 border py-1" style="background-color: #EBEBEB">@port.Diametr</div>
        <div class="col-2 border py-1" style="background-color: #EBEBEB">
            <div class="d-flex mb-1">
                <a asp-action="Edit" class="btn btn-sm btn-outline-warning flex-fill me-1" asp-route-id="@port.Id">Редактировать</a>
            </div>
        </div>
        <div class="col-2 border py-1" style="background-color: #EBEBEB">
            <form asp-action="Delete" method="post">
                <div class="d-flex mb-1">
                    <input type="hidden" name="id" value="@port.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger flex-fill me-1">Удалить</button>
                </div>
            </form>
        </div>
    </div>
}
