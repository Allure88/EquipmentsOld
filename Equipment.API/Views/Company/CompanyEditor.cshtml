@using Equipment.API.Models;
@model CompanyViewModel

@{
    ViewData["Title"] = ViewBag.CreateMode ? "Create" : "Edit";
    Layout = "_Layout";
}

<form asp-action="@(ViewBag.CreateMode ? "Create" : "Edit")" method="post" asp-controller="Company">
    <div class="form-group mb-5">
        <label asp-for="Name">Имя</label>
        <input asp-for="Name" class="form-control" />
        <input type="hidden" asp-for="Id" value="@Model.Id" class="form-control" />
    </div>


    <!-- STAGES-------------------------------------------------------------------------------------->
    @if (Model.Stages.Count > 0)
    {
        <label>Стадии</label>
    }
    @for (int j = 0; j < Model.Stages.Count(); j++)
    {
        <div class="row">
            <div class="col-auto border py-1" style="background-color: #EBEBEB ; min-width: 70px"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">@Model.Stages[j]</div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB"></div>
            <div class="col-2 border py-1" style="background-color: #EBEBEB">
                <div class="d-flex mb-1">
                    <a asp-controller="Company" asp-action="DeleteStage" class="btn btn-sm btn-outline-danger flex-fill me-1" asp-route-companyId="@Model.Id" asp-route-j="@j">Удалить</a>
                </div>
            </div>
        </div>
    }


    <!-- STAGES ДОБАВИТЬ----------------------------------------------------------------------------->
    @if (Model.Id != 0)
    {

        <select id="stage_selected" class="form-select form-select-lg my-3">
            @for (int i = 0; i < ViewBag.Stages.Count; i++)
            {
                <option value="@ViewBag.Stages[i]">@ViewBag.Stages[i]</option>
            }
        </select>
        <div class="row">
            <div class="col-2 py-1">
                <a id="add_stage" asp-controller="Company" asp-action="Index" class="btn btn-sm btn-outline-success flex-fill me-1" onclick="AddStageToCompany(@Model.Id)">
                    <div class="d-flex mb-1">
                        Добавить в список
                    </div>
                </a>
            </div>
        </div>
    }


    <div class="text-center mt-5">
        <button class="btn btn-outline-success" type="submit">Сохранить</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>


<script src="~/stageRedactor.js"></script>

